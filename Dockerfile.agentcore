# Amazon Bedrock AgentCore Runtime image for the KFC agent.
# AgentCore requires linux/arm64. Build on any machine with:
#   docker buildx build --platform linux/arm64 -f Dockerfile.agentcore -t kfc-agent:local .
# Local smoke test (mock provider, no AWS):
#   docker run --rm -p 8080:8080 -e AI_PROVIDER=mock -e PERSISTENCE_DRIVER=mock \
#     -e SESSION_SECRET=change-me-to-at-least-32-characters-long kfc-agent:local
# The image contains no credentials; on AgentCore the runtime role supplies them.
FROM --platform=linux/arm64 node:22-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm install --no-save typescript@5 @next/env

FROM --platform=linux/arm64 node:22-slim
ENV NODE_ENV=production PORT=8080 AGENTCORE_DEPLOYED=1
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY scripts/register-typescript.cjs scripts/agentcore-runtime.cjs ./scripts/
COPY src ./src
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:8080/ping').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "scripts/agentcore-runtime.cjs"]
