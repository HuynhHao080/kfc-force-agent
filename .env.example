# Offline assistant; no AWS account required.
AI_PROVIDER=mock

# local: durable single-process JSON store; mock: ephemeral test data.
# Cloud persistence is only enabled explicitly with dynamodb.
PERSISTENCE_DRIVER=local
LOCAL_DATA_DIR=.local

# Optional locally: a signing secret is generated in LOCAL_DATA_DIR/session-secret.
# Required for shared hosting/multiple instances: set a private random 32+ character value.
# SESSION_SECRET=

# Optional staff override (12+ characters). Otherwise use npm run admin:setup.
# ADMIN_PASSWORD=

# For an explicitly configured AWS integration only:
# AWS_REGION=ap-southeast-1
# DYNAMODB_TABLE_NAME=KfcForceAgent
# BEDROCK_MODEL_ID=
