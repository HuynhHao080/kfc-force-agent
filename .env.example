# Main flow (issue #16): order in chat → CONFIRMED order on the kitchen board, real Bedrock provider.
# Configure your own AWS profile.
AI_PROVIDER=bedrock
# Real KFC catalog (bundled snapshot or KFC_CATALOG_FILE): kfc | demo.
# Empty keeps the old behaviour (real catalog only with KFC_PURCHASE_ASSISTANT=1).
KFC_CATALOG=kfc
# Secondary mode, not in the thesis scope: 1 sends customers to the KFC website to order and pay
# (no kitchen order). Main flow is 0.
KFC_PURCHASE_ASSISTANT=0
# Agent mode with AI_PROVIDER=bedrock:
#   tools     = tool-using agent: the model searches the menu/cart and writes the reply,
#               verified against tool data before it is shown (docs/tool-agent.md).
#               2-4 model calls per message; raise BEDROCK_DAILY_REQUEST_LIMIT accordingly.
#   read-only = two-call advice-only agent (docs/read-only-llm-agent.md).
#   empty     = classic one-call purchase assistant.
# Offline config check: npm run llm:doctor
KFC_AGENT_MODE=
# Optional TinyFish catalog path, created by scripts/sync-kfc-menu.cjs.
# An empty value uses the reviewed public snapshot bundled with the application.
# Use a new LOCAL_DATA_DIR when initializing the imported catalog.
KFC_CATALOG_FILE=
# Apply a reviewed newer catalog on startup, with a private backup. One process only.
KFC_CATALOG_REFRESH=0
# Periodic TinyFish Fetch. Enable only with an approved recurring provider budget.
# Runs in the serving Node process, local persistence only. Survives server restart.
KFC_CATALOG_AUTO_REFRESH=0
KFC_CATALOG_INTERVAL_MINUTES=60
KFC_CATALOG_DAILY_FETCH_LIMIT=24
# Server-side only. Keep the real value in .env.local.
TINYFISH_API_KEY=

# local: durable single-process JSON store; mock: ephemeral test data.
# Cloud persistence is only enabled explicitly with dynamodb.
PERSISTENCE_DRIVER=local
LOCAL_DATA_DIR=.local/kfc-purchase

# Optional locally: a signing secret is generated in LOCAL_DATA_DIR/session-secret.
# Required for shared hosting/multiple instances: set a private random 32+ character value.
# SESSION_SECRET=

# Optional staff override (12+ characters). Otherwise use npm run admin:setup.
# ADMIN_PASSWORD=

AWS_PROFILE=default
AWS_REGION=ap-southeast-1
# DYNAMODB_TABLE_NAME=KfcForceAgent
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5

# Real inference ceiling per UTC day in one process. 0 disables calls.
BEDROCK_DAILY_REQUEST_LIMIT=25
